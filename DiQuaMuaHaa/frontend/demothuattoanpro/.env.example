# Vite reads these at build time; rebuild after changing deployment configuration.
# Required for production: actual HTTPS backend origin, or / with an explicit
# reverse proxy for /api and /socket.io. Do not include /api in VITE_API_BASE.
VITE_API_BASE=
# Optional legacy medical service. Missing config disables its requests in production.
VITE_MEDICAL_API_BASE=
# Optional landing-page integrations. Keep empty to disable or use their defaults.
VITE_CONTACT_EMAIL=
VITE_WEB3FORMS_ACCESS_KEY=
VITE_MAP_TILE_URL=
