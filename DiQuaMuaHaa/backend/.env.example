# Set these in your shell or hosting environment; the server does not auto-load .env.
DB_BACKEND=mysql
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=diquamuaha
# For PostgreSQL: DB_BACKEND=postgres and a real DATABASE_URL.
DATABASE_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://localhost:5173,https://127.0.0.1:5173
# Optional legacy medical API (len.py), not required by the DMS service.
JWT_SECRET_KEY=
MEDICAL_DATABASE_URL=
